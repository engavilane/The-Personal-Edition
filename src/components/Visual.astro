---
// Shows the entry's cover photo if it has one, otherwise a drawn placeholder in the section's style.
import type { SectionKey } from '../data/sections';
import { href } from '../data/entries';

interface Props { section: SectionKey; cover?: string; alt?: string; caption?: [string, string] }
const { section, cover, alt = '', caption } = Astro.props;

const ribbons = [
  'M40 300 C 90 120, 200 340, 250 160 S 380 60, 420 220',
  'M70 80 C 160 140, 120 260, 230 280 S 360 300, 440 120',
  'M120 330 C 140 200, 260 220, 280 90 S 400 140, 380 320',
  'M30 190 C 120 230, 180 60, 300 120 S 420 300, 460 260',
  'M200 40 C 170 140, 330 170, 300 260 S 160 330, 230 340',
];
const frames = Array.from({ length: 12 }, (_, i) => ({ x: 28 + (i % 4) * 108, y: 30 + Math.floor(i / 4) * 104, o: 0.45 + ((i * 37) % 50) / 100, label: `${12 + i}A` }));
const onDark = section === 'lab' || section === 'index';
---
<div class="visual">
  {cover ? <img src={href(cover)} alt={alt} loading="lazy" /> : section === 'lab' ? (
    <svg viewBox="0 0 480 384" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Ribbon drawing of a protein structure">
      <rect width="480" height="384" fill="var(--c)" />
      {ribbons.map((d, i) => <path d={d} fill="none" stroke="var(--on)" stroke-width={16 - i * 2} stroke-linecap="round" opacity={0.95 - i * 0.12} />)}
    </svg>
  ) : section === 'magazine' ? (
    <svg viewBox="0 0 480 384" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Magazine spread with two portrait frames">
      <rect width="480" height="384" fill="var(--paper-2)" />
      <line x1="240" y1="24" x2="240" y2="360" stroke="var(--ink)" stroke-opacity=".2" />
      <rect x="40" y="48" width="170" height="230" fill="var(--c)" />
      <rect x="270" y="48" width="170" height="230" fill="var(--ink)" />
      <circle cx="125" cy="140" r="38" fill="var(--on)" opacity=".85" /><path d="M60 278 C 80 200, 170 200, 190 278 Z" fill="var(--on)" opacity=".85" />
      <circle cx="355" cy="150" r="36" fill="var(--paper)" opacity=".85" /><path d="M292 278 C 310 205, 400 205, 420 278 Z" fill="var(--paper)" opacity=".85" />
      <rect x="40" y="296" width="120" height="6" fill="var(--ink)" opacity=".5" /><rect x="270" y="296" width="140" height="6" fill="var(--ink)" opacity=".5" />
    </svg>
  ) : section === 'guide' ? (
    <svg viewBox="0 0 480 384" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Contact sheet of twelve frames">
      <rect width="480" height="384" fill="var(--paper-2)" />
      {frames.map((f) => (<><rect x={f.x} y={f.y} width="98" height="78" fill="var(--c)" opacity={f.o} /><text x={f.x} y={f.y + 93} font-family="DM Mono, monospace" font-size="10" fill="var(--ink)" opacity=".7">{f.label}</text></>))}
      <rect x="244" y="132" width="106" height="88" fill="none" stroke="var(--magazine)" stroke-width="3" />
    </svg>
  ) : (
    <svg viewBox="0 0 480 384" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Index card">
      <rect width="480" height="384" fill="var(--c)" />
      <rect x="70" y="70" width="340" height="230" fill="var(--paper)" />
      <line x1="70" y1="120" x2="410" y2="120" stroke="var(--magazine)" stroke-width="2" />
      {[160, 190, 220, 250].map((y) => <line x1="90" y1={y} x2="390" y2={y} stroke="var(--lab)" stroke-opacity=".35" />)}
    </svg>
  )}
  {caption && <div class="cap mono" style={!cover && onDark ? 'color: var(--on)' : cover ? 'color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.5)' : 'color: var(--ink)'}><span>{caption[0]}</span><span>{caption[1]}</span></div>}
</div>
