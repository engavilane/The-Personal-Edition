---
import '../styles/global.css';
import { SECTIONS } from '../data/sections';
import { href } from '../data/entries';

interface Props {
  title?: string;
  description?: string;
  current?: string;      // key of the active section
  compact?: boolean;     // smaller masthead on inner pages
}
const { title, description = 'An independent publication about science, images, ideas, and the places in between.', current, compact = false } = Astro.props;
const pageTitle = title ? `${title} · The Personal Edition` : 'The Personal Edition';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Hanken+Grotesk:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class:list={['mast wrap', { compact }]}>
      {!compact && <div class="mast-top mono"><span>Vol. 01 · Est. 2026</span><span>Issue No. 001 · Autumn</span></div>}
      <a class="mast-title" href={href('/')}>The <em>Personal</em> Edition</a>
      {!compact && <p class="mast-sub mono">Science · Culture · Places · Observations <span aria-hidden="true">·</span> Edited by <b>Enya</b></p>}
      <nav class="depts" aria-label="Sections">
        <ul>
          {SECTIONS.map((s) => (
            <li class={`d-${s.key}`}>
              <a href={href(`/${s.key}/`)} aria-current={current === s.key ? 'page' : undefined}>
                <span class="dot" aria-hidden="true"></span>{s.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap mono"><span>A digital archive in progress</span><span>The Personal Edition · Edited by Enya · {new Date().getFullYear()}</span></div>
    </footer>
  </body>
</html>
