---
import Base from '../../layouts/Base.astro';
import Visual from '../../components/Visual.astro';
import { SECTIONS, type Section } from '../../data/sections';
import { getEntries, entryHref, href, fmtMonth } from '../../data/entries';

export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.key }, props: { s } }));
}
const { s } = Astro.props as { s: Section };
const entries = await getEntries(s.key);
const feature = entries.find((e) => e.data.featured) ?? entries[0];
---
<Base title={s.name} description={s.intro} current={s.key} compact>
  <div class={`d-${s.key}`}>
    <section class="s-hero">
      <div class="wrap">
        <span class="s-num" aria-hidden="true">{s.n}</span>
        <h1>{s.name}</h1>
        <div class="kick mono"><span>{s.kicker}</span><span>{s.dek}</span></div>
        <p class="intro">{s.intro}</p>
      </div>
    </section>
    <div class="wrap">
      <div class="crumbs mono"><a href={href('/')}>The Personal Edition</a><span>/</span><span>{s.name}</span></div>

      {feature && (
        <a class="feature" href={entryHref(feature)}>
          <Visual section={s.key} cover={feature.data.cover} alt={feature.data.coverAlt} caption={[feature.data.no ?? s.kicker, feature.data.meta[0] ?? '']} />
          <div>
            <span class="mono label">{feature.data.featured ? 'Featured' : 'Latest'}</span>
            <h2>{feature.data.title}</h2>
            <p>{feature.data.dek}</p>
            <div class="meta mono">{feature.data.meta.map((m) => <span>{m}</span>)}</div>
          </div>
        </a>
      )}

      <section class="s-body">
        <div>
          <div class="sec-head" style="border:0;padding:0;margin-bottom:12px"><h2>All entries</h2><span class="mono">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</span></div>
          {entries.length ? (
            <ul class="entries">
              {entries.map((e) => (
                <li><a href={entryHref(e)}>
                  <span class="mono no">{e.data.no}</span>
                  <div><h3>{e.data.title}</h3><p class="sub">{[e.data.series, ...e.data.meta.slice(0, 1)].filter(Boolean).join(' · ')}</p></div>
                  <span class="mono date">{fmtMonth(e.data.date)}</span>
                </a></li>
              ))}
            </ul>
          ) : <p class="empty">Nothing published here yet.</p>}
        </div>
        <aside class="aside">
          <span class="mono">About this section</span>
          <h3>{s.aside.title}</h3>
          <ul>{s.aside.items.map((i) => <li>{i}</li>)}</ul>
          <div class="series"><span class="mono">Series</span><br /><em>{s.series.name}</em><p class="muted" style="margin-top:4px">{s.series.note}</p></div>
        </aside>
      </section>
    </div>
  </div>
</Base>
